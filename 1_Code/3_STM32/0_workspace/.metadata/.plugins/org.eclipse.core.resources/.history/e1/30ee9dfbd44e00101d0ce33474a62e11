#include "cmsis_os2.h"
#include "SystemMonitor.h"
#include "../../Peripheral/LCD/lcd.h"

system_monitor_task_t System_Monitor;


void System_Monitor_Init(void)
{
	if (System_Monitor.taskHandle == NULL)
	{
		System_Monitor.taskAttr.name = "System_Monitor_Task";
		System_Monitor.taskAttr.priority = (osPriority_t) osPriorityHigh;
		System_Monitor.taskAttr.stack_size = 10 * 1024;
		System_Monitor.taskHandle = osThreadNew(System_Monitor_Task, NULL, &ESC.taskAttr);
	}
}


void System_Monitor_Task(void *argument)
{
	System_Monitor_Start();

  for(;;)
  {
	  System_Monitor_Loop();
	  osdelay(50);
  }
}



uint8_t System_Monitor_Start(void)
{
	LCD_LoadScreen(); // Ideally it would be nice if it logged things while the loadscreen is loading, as it is purely cosmetic but idgaf


}


