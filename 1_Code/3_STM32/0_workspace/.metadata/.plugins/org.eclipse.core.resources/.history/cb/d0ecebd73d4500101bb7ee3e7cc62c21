#include "Servo.h"


uint8_t Servo_Init(Servo_t *servo, TIM_HandleTypeDef *htim, uint32_t channel, uint16_t setpoint)
{
	servo->htim = htim;
	servo->channel = channel;
	HAL_TIM_PWM_Start(htim, channel);

	__HAL_TIM_SET_COMPARE(htim, channel, setpoint); // Set initial pulse width

}


