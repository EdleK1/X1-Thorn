#include "../../Peripheral/ESP32/ESP32.h"
#include "tim.h"
#include "cmsis_os2.h"
#include "FreeRTOS.h"
#include "MotorCharacterization.h"
#include "../../Lib/DshotProtocol/DShot.h"
#include "usart.h"



esp32_commands_t ESP32_commands;
osSemaphoreId_t  MotorCharacterization_Semaphore;
uint16_t Throttle_2 = 0;
uint16_t Throttle_4 = 0;
uint32_t mRPM_2 = 0;
uint32_t mRPM_4 = 0;
uint8_t MC_raw_telem[10];


osThreadId_t MotorCharacterization_TaskHandle;
uint32_t MotorCharacterization_TaskBuffer[ 8192 ];
StaticTask_t MotorCharacterization_TaskControlBlock;
const osThreadAttr_t MotorCharacterization_Task_attributes = {
  .name = "MotorCharacterization_Task",
  .cb_mem = &MotorCharacterization_TaskControlBlock,
  .cb_size = sizeof(MotorCharacterization_TaskControlBlock),
  .stack_mem = &MotorCharacterization_TaskBuffer[0],
  .stack_size = sizeof(MotorCharacterization_TaskBuffer),
  .priority = (osPriority_t) osPriorityHigh,
};




void Motor_Characterization_Init(void)
{
	MotorCharacterization_TaskHandle = osThreadNew(Motor_Characterization_Task, NULL, &MotorCharacterization_Task_attributes);
}


void Motor_Characterization_Task(void *argument)
{

	ESP32_Init();
	DShot_Init();


	MotorCharacterization_Semaphore = osSemaphoreNew(1, 0, NULL);

	if (MotorCharacterization_Semaphore == NULL)
	{
		return;
	}





	HAL_TIM_Base_Start_IT(&htim17);



	for(uint32_t i = 0; i < 4000; i++)
	{
		osSemaphoreAcquire(MotorCharacterization_Semaphore, 1);

		DShot_SendFrame(0, 0, &mRPM_2, &mRPM_4, 0, 0);
	}

	uint32_t ii = 0;

	HAL_UART_Receive_IT(&huart8, MC_raw_telem, 10);

	for(;;)
	{



//		Throttle_2 = (int)ESP32_commands.ax_command;
		Throttle_2 = 0;
//		Throttle_4 = (int)ESP32_commands.p_command;
		Throttle_4 = 0;

//		DShot_SendFrame(Throttle_2, Throttle_4, &mRPM_2, &mRPM_4, 1, 0);

		ii += 1;

		if (ii < 40)
		{
			osSemaphoreAcquire(MotorCharacterization_Semaphore, 10);
			DShot_SendFrame(Throttle_2, Throttle_4, &mRPM_2, &mRPM_4, 1, 0);
		}
		else
		{
			osSemaphoreAcquire(MotorCharacterization_Semaphore, 10);
			DShot_SendFrame(Throttle_2, Throttle_4, &mRPM_2, &mRPM_4, 1, 1);

			ii = 0;
			ESP32_Send_ESC_Status();
			ESP32_Get_Commands(&ESP32_commands);
		}
	}

//	vTaskDelete(NULL);
}


