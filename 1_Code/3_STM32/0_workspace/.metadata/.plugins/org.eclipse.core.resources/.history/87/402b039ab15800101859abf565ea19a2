void ESC_Init(void)
{
	ESC_TaskHandle = osThreadNew(ESC_Task, NULL, &ESC_Task_attributes);
}


void ESC_Task(void *argument)
{
	ESC_Start();

	for(;;)
	{
		ESC_Loop();
	}
}


