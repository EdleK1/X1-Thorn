void System_Monitor_Init(void)
{
	if (System_Monitor.taskHandle == NULL)
	{
		System_Monitor.taskAttr.name = "System_Monitor_Task";
		System_Monitor.taskAttr.priority = (osPriority_t) osPriorityLow;
		System_Monitor.taskAttr.stack_size = 10 * 1024;
		System_Monitor.taskHandle = osThreadNew(System_Monitor_Task, NULL, &System_Monitor.taskAttr);
	}
}


void System_Monitor_Task(void *argument)
{
	System_Monitor_Start();

  for(;;)
  {
	  System_Monitor_Loop();
	  osDelay(50);
  }
}



void System_Monitor_Start(void)
