void get_LCD_display(uint16_t *Throttle_2_LCD, uint16_t *mRPM_2_LCD_Telemetry, uint32_t *mRPM_2_LCD, float *Voltage_Telemetry)
{
	*Throttle_2_LCD = Throttle_2;
	*mRPM_2_LCD_Telemetry = (MC_raw_telem[7]<<8 | MC_raw_telem[8])*100;
	*mRPM_2_LCD = mRPM_2;
	*Voltage_Telemetry = (MC_raw_telem[1]<<8 | MC_raw_telem[2])/100.0;
}


void MC_Read_Telemetry(MCtelemetry_t *New_Telemetry)
{

	New_Telemetry->Temperature = MC_raw_telem[0];
	New_Telemetry->Voltage = (MC_raw_telem[1]<<8 | MC_raw_telem[2])/100.0;
	New_Telemetry->Current = (MC_raw_telem[3]<<8 | MC_raw_telem[4]);
	New_Telemetry->Consumption = (MC_raw_telem[5]<<8 | MC_raw_telem[6]);
	New_Telemetry->RPM2 = (MC_raw_telem[7]<<8 | MC_raw_telem[8])*100;
	New_Telemetry->RPM2_DSHOT = mRPM_2;
	New_Telemetry->CRC_bit = MC_raw_telem[9];

}


void TIM_PeriodElapsedCallback_MotorCharacterization_Timer(void)
{
	osSemaphoreRelease(MotorCharacterization_Semaphore);
}


void UART_ESC_Motor_CharRxCpltCallback()
{
	HAL_UART_Receive_IT(&huart8, MC_raw_telem, 10);
}


void UART_ESC_Motor_CharErrorCallback()
{
	// Clear the error flags
	__HAL_UART_CLEAR_OREFLAG(&huart8);
	// Optionally log huart5.ErrorCode
	// Re-arm reception so you don’t lock up
	HAL_UART_Receive_IT(&huart8, MC_raw_telem, 10);
}

